# Proxycurl — LinkedIn enrichment API (nubela.co/proxycurl)
# Credits are consumed per lookup. Use 'if-recent' cache param to minimize spend.
PROXYCURL_API_KEY=your_proxycurl_key_here

# Slack Incoming Webhook URL
# Create at: api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
